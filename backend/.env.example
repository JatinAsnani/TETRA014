# FRIDAY AI Financial Accounting & Risk Scanner — Backend Environment Configuration
# Copy this file to .env and fill in your actual production/development credentials.

# Gemini AI API Key (Required for AI Vision OCR & FRIDAY Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection (Primary Production Cloud NoSQL Database)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/friday?retryWrites=true&w=majority
MONGODB_DB_NAME=friday

# JWT Authentication Secret Key (Required for production security)
SECRET_KEY=change_this_to_a_secure_random_256_bit_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite or MySQL/PostgreSQL Fallback)
USE_SQLITE=true
DATABASE_URL=sqlite:///./friday.db

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173

# Optional: Google OAuth Client ID for SSO
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Optional: OCR.space API Key Fallback
OCR_SPACE_API_KEY=helloworld
